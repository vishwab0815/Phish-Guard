# ============================================
# PhishGuard environment variables
# Copy to .env.local (never commit .env.local) and fill in the values.
# Stack: Next.js + Drizzle ORM + Postgres (Supabase or any Postgres host)
# ============================================

# --------------------------------------------
# REQUIRED
# --------------------------------------------

# Postgres connection used by the app at runtime.
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# The app uses prepare:false, so transaction-mode poolers work.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres"

# Direct (non-pooled) connection, recommended for schema changes with drizzle-kit.
# Supabase: "Session pooler" (port 5432) or the direct connection string.
# NOTE: drizzle.config.ts currently reads DATABASE_URL; point it at DIRECT_URL to use this.
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# Public URL of the app (http://localhost:3000 locally; your production URL when deployed).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign the anonymous session cookie. At least 32 characters.
# REQUIRED in production (the server refuses to start sessions without it).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --------------------------------------------
# OPTIONAL
# --------------------------------------------

# Token for admin-only endpoints (send it in the `x-admin-token` header):
#   PUT /api/threat-intel/domain (trust/block domains for everyone), GET /api/test-apis
# Leave empty to disable those endpoints entirely (they return 404).
# Generate the same way as SESSION_SECRET.
ADMIN_API_TOKEN=""

# VirusTotal — multi-engine URL/file reputation. https://www.virustotal.com/gui/join-us
# Free tier: 500 lookups/day, 4 requests/minute.
VIRUSTOTAL_API_KEY=""

# Google Safe Browsing — URL reputation. https://console.cloud.google.com (enable "Safe Browsing API").
GOOGLE_SAFE_BROWSING_API_KEY=""

# Groq — powers the AI assistant and AI message analysis (free tier). https://console.groq.com
# Without it, the assistant gives fixed safety tips and messages are checked with built-in rules.
GROQ_API_KEY=""
# Optional: Groq model id (default openai/gpt-oss-120b). Groq retires models over time;
# list current ones with: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=""

# PhishTank — known-phishing URL database. NOTE: PhishTank registrations have been closed
# for a long time; only set this if you already have a key.
PHISHTANK_API_KEY=""

# Without the optional keys the app still works using its built-in checks
# (URL patterns, domain/SSL checks, email header analysis, file signatures),
# but detection is less thorough than with external reputation services.

# --------------------------------------------
# SETUP
# --------------------------------------------
# 1. cp .env.example .env.local and fill in DATABASE_URL, DIRECT_URL, SESSION_SECRET
# 2. npm run db:push     # create tables (drizzle-kit does not read .env.local by itself;
#                        #  export DATABASE_URL in your shell first)
# 3. npm run db:seed     # optional: model configs + sample trusted/blocked domains
# 4. npm run dev
